{
    "extends": "../tsconfig.json",
    "include": ["src"],
    "exclude": ["node_modules", "build"],
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "./build",
        "noEmit": true, // tsc is used for type-checking only — Vite (esbuild) does the actual build
        "jsx": "react-jsx", // Enable JSX support (use "react-jsx" for React 17+)
        "types": ["vite/client"],
        "strict": true, // Enables all strict type-checking options.
        "esModuleInterop": true, // Enables emit interoperability between CommonJS and ES Modules.
        "forceConsistentCasingInFileNames": true // Ensures that file names are consistently cased.
    }
}
